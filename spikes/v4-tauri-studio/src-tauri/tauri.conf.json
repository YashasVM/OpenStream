{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStream Studio Spike",
  "version": "0.1.0",
  "identifier": "dev.openstream.studio-spike",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build:web", "frontendDist": "../dist" },
  "app": {
    "security": { "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" },
    "windows": [{ "title": "OpenStream Studio feasibility spike", "width": 1180, "height": 760, "minWidth": 700, "minHeight": 540, "resizable": true }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "nsis": { "installMode": "currentUser" } }
  }
}
