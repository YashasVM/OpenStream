<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/os_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera and streaming preferences apply after you save. OBS reconnects if a camera setting changes."
            android:textColor="@color/os_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIDEO QUALITY"
            android:textColor="@color/os_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/settingsQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/qualityHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="High · 1080p60 · 50 Mbps"
                android:textColor="@color/os_text_primary"
                android:buttonTint="@color/os_accent" />

            <RadioButton
                android:id="@+id/qualityBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Balanced · 1080p30 · 12 Mbps"
                android:textColor="@color/os_text_primary"
                android:buttonTint="@color/os_accent" />

            <RadioButton
                android:id="@+id/qualityDataSaver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Data saver · 720p30 · 8 Mbps"
                android:textColor="@color/os_text_primary"
                android:buttonTint="@color/os_accent" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An explicit bitrate set in the OBS source overrides this preset's bitrate."
            android:textColor="@color/os_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/settingsMicrophone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Stream microphone audio"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/settingsKeepAwake"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Keep screen awake"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NETWORK"
            android:textColor="@color/os_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SRT listening port"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/settingsListeningPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="9100"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The phone advertises this port to OBS automatically."
            android:textColor="@color/os_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_btn"
            android:text="@string/settings_save"
            android:textAllCaps="false"
            android:textColor="@color/os_black"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/settingsVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
