<?xml version="1.0" encoding="utf-8"?>
<!-- Brutalist custom update dialog layout.
     Rendered inside a Dialog with transparent window background
     so the flat offset shadow is visible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Shadow layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="#FF000000" />

    <!-- Foreground card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_brutalist_card"
        android:padding="24dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_title"
            android:textColor="@color/os_accent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:layout_marginBottom="16dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/dialogUpdateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/os_text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/dialogUpdateDismiss"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="@string/update_dismiss"
                android:textColor="@color/os_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/dialogUpdateAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_primary"
                android:text="@string/update_action"
                android:textColor="@color/os_accent_on"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
