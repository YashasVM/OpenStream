<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_minimal_panel"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialogUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Update available"
            android:textColor="@color/os_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/dialogUpdateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/os_text_secondary"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/dialogUpdateProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:indeterminate="false"
            android:progressTint="@color/os_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dialogUpdateProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogUpdateDismiss"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Later"
                android:textColor="@color/os_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dialogUpdateAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_minimal_btn"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Download"
                android:textColor="@color/os_black"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
