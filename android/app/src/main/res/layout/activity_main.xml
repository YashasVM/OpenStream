<?xml version="1.0" encoding="utf-8"?>
<!-- OpenStream — Neo-Brutalist split-screen layout.
     Top: camera preview (weight-based, fills available space).
     Bottom: solid dark control panel with brutalist cards and buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/os_background">

    <!-- ====== CAMERA PREVIEW — top section, fills remaining height ====== -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/os_black">

        <SurfaceView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- SCREEN-OFF OVERLAY -->
        <View
            android:id="@+id/screenOffOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- IDENTIFY OVERLAY -->
        <TextView
            android:id="@+id/identifyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/os_overlay_dark"
            android:gravity="center"
            android:textColor="@color/os_accent"
            android:textSize="54sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="10dp"
            android:visibility="gone" />

        <!-- TOP OVERLAY — LIVE badge + stream info + zoom (floats over preview) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:paddingStart="@dimen/os_spacing_lg"
            android:paddingEnd="@dimen/os_spacing_lg"
            android:paddingTop="44dp"
            android:paddingBottom="@dimen/os_spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- LIVE badge -->
                <LinearLayout
                    android:id="@+id/liveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/liveDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/live_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:textColor="@color/os_live_red"
                        android:textSize="@dimen/os_text_caption"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.15"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Stream info chip -->
                <TextView
                    android:id="@+id/streamInfoChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/os_text_secondary"
                    android:textSize="@dimen/os_text_tiny"
                    android:fontFamily="monospace"
                    android:layout_marginStart="@dimen/os_spacing_sm"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Zoom label -->
                <TextView
                    android:id="@+id/zoomLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/os_accent"
                    android:textSize="@dimen/os_text_body"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- ====== BOTTOM CONTROL PANEL — solid dark brutalist surface ====== -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/os_background"
        android:paddingStart="@dimen/os_spacing_lg"
        android:paddingEnd="@dimen/os_spacing_lg"
        android:paddingTop="@dimen/os_spacing_lg"
        android:paddingBottom="@dimen/os_spacing_xl"
        android:fitsSystemWindows="true">

        <!-- Top border line — brutalist separator between preview and controls -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/os_border_hard"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="@dimen/os_spacing_lg" />

        <!-- Status block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/os_spacing_md">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_ready"
                android:textColor="@color/os_text_primary"
                android:textSize="@dimen/os_text_headline"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/os_text_tertiary"
                android:textSize="@dimen/os_text_tiny"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- OBS Slot List (populated programmatically) -->
        <LinearLayout
            android:id="@+id/obsSlotList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/os_spacing_md" />

        <!-- PORT SELECTOR ROW (hidden by default) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/os_spacing_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORT"
                android:textColor="@color/os_text_tertiary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginEnd="@dimen/os_spacing_sm" />

            <TextView
                android:id="@+id/btnPortDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="−"
                android:textColor="@color/os_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/portLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9000"
                android:textColor="@color/os_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingStart="@dimen/os_spacing_sm"
                android:paddingEnd="@dimen/os_spacing_sm" />

            <TextView
                android:id="@+id/btnPortUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="+"
                android:textColor="@color/os_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lens selector row -->
        <LinearLayout
            android:id="@+id/lensSelectorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/os_spacing_md">
            <!-- Lens buttons are added programmatically -->
        </LinearLayout>

        <!-- Utility buttons row — brutalist grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Screen off toggle -->
            <TextView
                android:id="@+id/btnScreenOff"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="DISPLAY"
                android:textColor="@color/os_text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:layout_marginEnd="@dimen/os_spacing_xs" />

            <!-- Keep screen on toggle -->
            <TextView
                android:id="@+id/btnKeepScreenOn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="STAY"
                android:textColor="@color/os_text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:layout_marginEnd="@dimen/os_spacing_xs" />

            <!-- Torch toggle -->
            <TextView
                android:id="@+id/btnTorch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="LIGHT"
                android:textColor="@color/os_text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:layout_marginEnd="@dimen/os_spacing_xs" />

            <!-- Flip camera button -->
            <TextView
                android:id="@+id/btnFlipCamera"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="@string/btn_flip_camera"
                android:textColor="@color/os_text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginEnd="@dimen/os_spacing_xs" />

            <!-- Settings button (replaces ADV toggle) -->
            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_ghost"
                android:text="@string/btn_settings"
                android:textColor="@color/os_text_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:layout_marginEnd="@dimen/os_spacing_xs" />

            <!-- Stop button -->
            <TextView
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_control_btn_height"
                android:gravity="center"
                android:background="@drawable/bg_brutalist_btn_danger"
                android:text="STOP"
                android:textColor="@color/os_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Credit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Made by @yashas.vm"
            android:textColor="@color/os_text_tertiary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:layout_marginTop="@dimen/os_spacing_md"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- ====== MANUAL CONNECT PANEL — hidden, used only if Settings not available ====== -->
    <LinearLayout
        android:id="@+id/manualContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/os_background"
        android:padding="@dimen/os_spacing_lg"
        android:visibility="gone"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_manual"
            android:textColor="@color/os_accent"
            android:textSize="@dimen/os_text_caption"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:layout_marginBottom="@dimen/os_spacing_md" />

        <TextView
            android:id="@+id/connectionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/os_text_tertiary"
            android:textSize="@dimen/os_text_tiny"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/os_spacing_md" />

        <EditText
            android:id="@+id/inputObsHost"
            android:layout_width="match_parent"
            android:layout_height="@dimen/os_input_height"
            android:hint="@string/hint_obs_host"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="@dimen/os_text_body"
            android:fontFamily="monospace"
            android:background="@drawable/bg_brutalist_input"
            android:paddingStart="@dimen/os_spacing_md"
            android:paddingEnd="@dimen/os_spacing_md"
            android:singleLine="true"
            android:layout_marginBottom="@dimen/os_spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/os_spacing_md">

            <EditText
                android:id="@+id/inputObsPort"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_input_height"
                android:hint="@string/hint_obs_port"
                android:textColor="@color/os_text_primary"
                android:textColorHint="@color/os_text_tertiary"
                android:textSize="@dimen/os_text_body"
                android:fontFamily="monospace"
                android:inputType="number"
                android:background="@drawable/bg_brutalist_input"
                android:paddingStart="@dimen/os_spacing_md"
                android:paddingEnd="@dimen/os_spacing_md"
                android:singleLine="true"
                android:layout_marginEnd="@dimen/os_spacing_sm" />

            <EditText
                android:id="@+id/inputLatency"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/os_input_height"
                android:hint="@string/hint_latency"
                android:textColor="@color/os_text_primary"
                android:textColorHint="@color/os_text_tertiary"
                android:textSize="@dimen/os_text_body"
                android:fontFamily="monospace"
                android:inputType="number"
                android:background="@drawable/bg_brutalist_input"
                android:paddingStart="@dimen/os_spacing_md"
                android:paddingEnd="@dimen/os_spacing_md"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnManualConnect"
            android:layout_width="match_parent"
            android:layout_height="@dimen/os_input_height"
            android:gravity="center"
            android:background="@drawable/bg_brutalist_btn_primary"
            android:text="@string/btn_connect"
            android:textColor="@color/os_accent_on"
            android:textSize="@dimen/os_text_body"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>
</LinearLayout>
