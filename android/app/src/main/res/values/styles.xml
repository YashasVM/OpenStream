<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/os_black</item>
        <item name="android:colorPrimaryDark">@color/os_black</item>
        <item name="android:colorAccent">@color/os_accent</item>
        <item name="android:windowBackground">@color/os_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MinimalDialogTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
    </style>

    <style name="OpenStream.Control" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_minimal_pill</item>
        <item name="android:textColor">@color/os_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="OpenStream.HudStatus" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_hud_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">13dp</item>
        <item name="android:textColor">@color/os_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">48dp</item>
    </style>
    <style name="OpenStream.HudControl" parent="OpenStream.HudStatus">
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/os_text_primary</item>
    </style>
    <style name="OpenStream.PaletteMode" parent="OpenStream.Control">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_lens_selector</item>
    </style>
    <style name="OpenStream.PaletteLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/os_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="OpenStream.PaletteValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/os_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="OpenStream.PaletteSlider" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:progressTint">@color/os_accent</item>
        <item name="android:thumbTint">@color/os_accent</item>
    </style>
    <style name="OpenStream.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item><item name="android:textColor">@color/os_accent</item>
        <item name="android:textSize">12sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item>
    </style>
    <style name="OpenStream.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item><item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/os_text_secondary</item><item name="android:textSize">13sp</item>
    </style>
    <style name="OpenStream.Input" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">12dp</item><item name="android:background">@drawable/bg_minimal_input</item>
        <item name="android:paddingHorizontal">16dp</item><item name="android:singleLine">true</item>
        <item name="android:textColor">@color/os_text_primary</item><item name="android:textColorHint">@color/os_text_tertiary</item><item name="android:textSize">16sp</item>
    </style>
    <style name="OpenStream.PrimaryButton" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item><item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_minimal_btn</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/os_accent_on</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="OpenStream.SecondaryButton" parent="OpenStream.PrimaryButton">
        <item name="android:background">@drawable/bg_minimal_btn_ghost</item><item name="android:textColor">@color/os_text_primary</item>
    </style>
    <style name="OpenStream.TextButton" parent="OpenStream.SecondaryButton"><item name="android:layout_marginTop">10dp</item></style>
</resources>
